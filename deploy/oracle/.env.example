# Oracle Cloud VM environment for krettel-app (docker compose).
# Copy this file to `deploy/oracle/.env` and fill in the values.

# --- App ---------------------------------------------------------------
APP_NAME=Krettel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example.com
# Generate with: openssl rand -base64 32
APP_KEY=

# --- Domain (used by Caddy for HTTPS) ------------------------------------
SITE_DOMAIN=your-domain.example.com

# --- Database (SQLite on the persistent volume) -------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database.sqlite

# DB-backed session / cache / queue (no Redis needed)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- TeraBox (keep in sync with your Render/.env) -----------------------
TERABOX_EMAIL=
TERABOX_PASSWORD=
TERABOX_NDUS=
TERABOX_REMOTE_DIR=/Apps/Krettel
TERABOX_WEB_HOST=https://www.1024terabox.com

# --- Pixeldrain (needed for uploads, streaming, variants, images) --------
PIXELDRAIN_API_KEY=
PIXELDRAIN_BASE_URL=https://pixeldrain.net
