# PHPix-safe Laravel front-controller rewrite for Wasmer Edge.
# No Apache-only directives (<IfModule>, Options); absolute /index.php target
# because PHPix's htaccess evaluator validates the rewritten request path.
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /index.php [L]