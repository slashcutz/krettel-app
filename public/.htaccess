# PHPix-safe Laravel front-controller rewrite.
# NO Apache-only directives here (<IfModule>, Options, php_value) — PHPix's
# .htaccess evaluator chokes on those. This ships to Wasmer Edge and routes
# every non-file request to index.php.
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]